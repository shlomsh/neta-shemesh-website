{
  // Type-checks tests/ (Playwright) and tests-unit/ (Vitest) with the app's settings except
  // noUncheckedIndexedAccess, which guards shipped code (src/) only. `npm run typecheck` runs both projects.
  "extends": "./tsconfig.json",
  "compilerOptions": { "noUncheckedIndexedAccess": false },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "**/*.mts"],
  "exclude": ["node_modules"]
}
